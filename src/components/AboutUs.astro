---
import { storeConfig } from '../data/storeConfig.js';
import { withBase } from '../utils/assets.js';
---

<section class="about-us-section" id="quienes-somos" aria-label="Quiénes somos y nuestra esencia">
  <div class="container">
    <div class="about-grid">
      <!-- Columna Izquierda: Composición Visual con Fotos del Obrador y Tarjeta 3x10€ -->
      <div class="about-visual-col">
        <div class="about-mosaic-grid">
          <!-- Foto vertical artesanal -->
          <div class="mosaic-tall-card">
            <img 
              src={withBase("/images/about/artesano-cortando-jabon.jpg")} 
              alt="Corte artesanal de barra de jabón natural en obrador de Tenerife" 
              loading="lazy"
              class="mosaic-img"
            />
          </div>

          <!-- Columna derecha del mosaico -->
          <div class="mosaic-subcol">
            <!-- Foto de extractos botánicos y aloe -->
            <div class="mosaic-square-card">
              <img 
                src={withBase("/images/about/extractos-aloe-miel.jpg")} 
                alt="Extractos botánicos vivos, aloe vera canario y aceites vírgenes" 
                loading="lazy"
                class="mosaic-img"
              />
            </div>

            <!-- Tarjeta Tarifa Especial 3 por 10€ -->
            <div class="mosaic-promo-card">
              <span class="promo-card-tag">TARIFA ESPECIAL</span>
              <h3 class="promo-card-price">3 por 10€</h3>
              <p class="promo-card-sub">
                Elige tus 3 variedades predilectas a 3.33€/unidad.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Contenido Editorial y Propósito de Marca -->
      <div class="about-content-col">
        <div class="about-tag-wrap">
          <span class="about-essence-badge">
            <span class="badge-icon">🌱</span>
            <span>NUESTRA ESENCIA</span>
          </span>
        </div>

        <h2 class="about-heading">
          Nacimos con un propósito simple y honesto: devolver a tu piel la calma y pureza que la rutina diaria le quita.
        </h2>

        <p class="about-paragraph">
          En <strong>{storeConfig.name}</strong> creemos que el momento del baño no debe ser un trámite acelerado, sino un ritual sagrado de desconexión. En nuestro pequeño obrador en La Orotava (Tenerife), combinamos la glicerina vegetal pura con aceites vírgenes, extractos autóctonos como el aloe canario y flores cosechadas con respeto.
        </p>

        <p class="about-paragraph">
          Cada barra está cortada, moldeada y sellada a mano con caricia absoluta. Sin prisas industriales, sin conservantes innecesarios. Solo cosmética que se siente viva, hace una espuma untuosa y nutre desde el primer contacto con el agua.
        </p>

        <!-- Tarjetas de valores / pilares -->
        <div class="about-feature-cards">
          <div class="feature-card">
            <div class="feature-card-header">
              <span class="feature-icon">🤝</span>
              <h4 class="feature-title">Trato Cercano y Real</h4>
            </div>
            <p class="feature-desc">
              Te asesoramos por WhatsApp según tu tipo de piel antes de comprar.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-card-header">
              <span class="feature-icon">📦</span>
              <h4 class="feature-title">Lotes Pequeños</h4>
            </div>
            <p class="feature-desc">
              Garantía de máxima frescura en cada ingrediente activo botánico.
            </p>
          </div>
        </div>

        <!-- Botón de acción con WhatsApp -->
        <div class="about-cta-wrap">
          <a 
            href={`https://wa.me/${storeConfig.whatsAppNumber}?text=Hola%20Nubeterapia%2C%20quisiera%20asesoramiento%20sobre%20vuestros%20jabones%20artesanales.`}
            target="_blank" 
            rel="noopener noreferrer" 
            class="about-artisan-btn"
            aria-label="Hablar directamente con el artesano por WhatsApp"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/>
            </svg>
            <span>Hablar con el artesano</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-us-section {
    padding: 5rem 0;
    background-color: var(--color-background);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .about-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: 4.5rem;
    }
  }

  /* Mosaico visual */
  .about-mosaic-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 1.15rem;
    align-items: stretch;
  }

  .mosaic-tall-card {
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(22, 51, 40, 0.1);
    background-color: var(--color-cream);
    display: flex;
  }

  .mosaic-subcol {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .mosaic-square-card {
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(22, 51, 40, 0.08);
    background-color: var(--color-cream);
    aspect-ratio: 1 / 1;
    display: flex;
  }

  .mosaic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  .mosaic-tall-card:hover .mosaic-img,
  .mosaic-square-card:hover .mosaic-img {
    transform: scale(1.04);
  }

  /* Tarjeta Tarifa Especial */
  .mosaic-promo-card {
    background-color: #163328;
    color: #FFFFFF;
    border-radius: 18px;
    padding: 1.35rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 10px 24px rgba(22, 51, 40, 0.18);
    flex: 1;
  }

  .promo-card-tag {
    font-size: 0.7rem;
    font-weight: 700;
    color: #FDB382;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .promo-card-price {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.2;
    margin: 0.15rem 0 0.35rem;
  }

  .promo-card-sub {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.4;
    margin: 0;
  }

  /* Columna de contenido */
  .about-tag-wrap {
    margin-bottom: 0.85rem;
  }

  .about-essence-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: rgba(198, 146, 20, 0.12);
    color: #7A6230;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
  }

  .badge-icon {
    font-size: 0.85rem;
  }

  .about-heading {
    font-family: var(--font-serif);
    font-size: 2.15rem;
    color: #163328;
    line-height: 1.26;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
  }

  .about-paragraph {
    font-size: 0.95rem;
    line-height: 1.68;
    color: var(--color-text-body);
    margin-bottom: 1rem;
  }

  .about-paragraph strong {
    color: var(--color-text-main);
  }

  /* Tarjetas de características */
  .about-feature-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 1.75rem 0 2rem;
  }

  @media (min-width: 580px) {
    .about-feature-cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.15rem 1.25rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .feature-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(22, 51, 40, 0.08);
  }

  .feature-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .feature-icon {
    font-size: 1.1rem;
  }

  .feature-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: #163328;
    margin: 0;
  }

  .feature-desc {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Botón CTA artesano */
  .about-cta-wrap {
    display: flex;
  }

  .about-artisan-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background-color: #163328;
    color: #FFFFFF;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 0.85rem 1.65rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(22, 51, 40, 0.22);
    transition: all var(--transition-fast);
  }

  .about-artisan-btn:hover {
    background-color: #244C3D;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(22, 51, 40, 0.3);
  }

  /* Responsive Móvil */
  @media (max-width: 767px) {
    .about-us-section {
      padding: 3rem 0;
    }

    .about-heading {
      font-size: 1.45rem;
      line-height: 1.28;
      margin-bottom: 1rem;
    }

    .about-paragraph {
      font-size: 0.88rem;
      line-height: 1.55;
    }

    .about-mosaic-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .mosaic-promo-card {
      padding: 1rem 0.85rem;
    }

    .promo-card-price {
      font-size: 1.35rem;
    }

    .promo-card-sub {
      font-size: 0.72rem;
    }

    .about-artisan-btn {
      width: 100%;
      justify-content: center;
      font-size: 0.88rem;
    }
  }
</style>
