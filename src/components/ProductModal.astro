---
// Modal de detalle de producto integrado
---

<div class="product-modal-backdrop" id="product-modal-backdrop" aria-hidden="true"></div>

<div class="product-modal" id="product-modal" role="dialog" aria-labelledby="modal-product-title" aria-modal="true">
  <div class="modal-dialog-inner">
    <!-- Botón cerrar -->
    <button type="button" class="modal-close-btn" id="modal-close-btn" aria-label="Cerrar detalle de producto">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="modal-body-layout">
      <!-- Columna Izquierda: Galería e Imagen Ampliable -->
      <div class="modal-gallery-col">
        <div class="modal-main-image-container" id="modal-main-image-container">
          <img 
            id="modal-product-image" 
            src="" 
            alt="Imagen del producto" 
            class="modal-main-image"
          />
          <button type="button" class="zoom-indicator-btn" id="modal-zoom-btn" aria-label="Ver imagen ampliada">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
            <span>Zoom</span>
          </button>
        </div>

        <div class="modal-thumbnails-strip" id="modal-thumbnails-strip">
          <!-- Miniaturas dinámicas inyectadas vía JS -->
        </div>
      </div>

      <!-- Columna Derecha: Información completa de producto -->
      <div class="modal-info-col">
        <div class="modal-header-meta">
          <span class="modal-cat-badge" id="modal-product-category">Jabones Artesanales</span>
          <span class="modal-stock-badge in-stock">
            <span class="badge-stock-dot"></span>
            En Stock • Listo para enviar
          </span>
        </div>

        <h2 class="modal-product-title" id="modal-product-title">Nombre del Producto</h2>

        <div class="modal-price-weight-row">
          <span class="modal-product-price" id="modal-product-price">0,00€</span>
          <span class="modal-product-weight" id="modal-product-weight">100g aprox.</span>
        </div>

        <!-- Selector interactivo de Formato / Tamaño / Peso -->
        <div class="modal-variants-block" id="modal-variants-block">
          <div class="modal-variants-header">
            <span class="modal-variants-title">Elige tamaño o formato:</span>
            <span class="selected-variant-label" id="modal-selected-variant-label">Formato Estándar</span>
          </div>
          <div class="modal-variants-chips" id="modal-variants-chips" role="radiogroup" aria-label="Variantes de tamaño y peso">
            <!-- Píldoras inyectadas dinámicamente vía JS -->
          </div>
        </div>

        <div class="modal-promo-box" id="modal-promo-box" style="display: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span id="modal-promo-text">Promoción especial</span>
        </div>

        <p class="modal-product-description" id="modal-product-description">
          Descripción completa del producto artesanal.
        </p>

        <!-- Beneficios -->
        <div class="modal-section-block">
          <h4 class="modal-subheading">Beneficios clave:</h4>
          <ul class="modal-benefits-list" id="modal-product-benefits">
            <!-- Beneficios inyectados por JS -->
          </ul>
        </div>

        <!-- Ingredientes naturales -->
        <div class="modal-section-block">
          <h4 class="modal-subheading">Ingredientes 100% naturales:</h4>
          <div class="modal-ingredients-chips" id="modal-product-ingredients">
            <!-- Chips inyectados por JS -->
          </div>
        </div>

        <!-- Tipo de piel -->
        <div class="modal-skin-type-note">
          <strong>Tipo de piel recomendado:</strong>
          <span id="modal-product-skintype">Todo tipo de piel</span>
        </div>

        <!-- Selector de cantidad y botón añadir al carrito -->
        <div class="modal-purchase-footer">
          <div class="quantity-picker" aria-label="Selector de cantidad">
            <button type="button" class="qty-btn" id="modal-qty-decrease" aria-label="Disminuir cantidad">-</button>
            <input type="number" id="modal-qty-input" value="1" min="1" max="99" aria-label="Cantidad" readonly />
            <button type="button" class="qty-btn" id="modal-qty-increase" aria-label="Aumentar cantidad">+</button>
          </div>

          <button type="button" class="btn btn-primary modal-add-cart-btn" id="modal-add-cart-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-7z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span>Añadir al carrito</span>
            <span class="modal-btn-subtotal" id="modal-btn-subtotal"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .product-modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(24, 21, 18, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-normal);
    z-index: 200;
  }

  .product-modal-backdrop.is-active {
    opacity: 1;
    visibility: visible;
  }

  .product-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -46%) scale(0.96);
    width: 92%;
    max-width: 960px;
    max-height: 90vh;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    z-index: 210;
    opacity: 0;
    visibility: hidden;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-modal.is-active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .modal-dialog-inner {
    position: relative;
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
  }

  .modal-close-btn {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--color-cream-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-main);
    z-index: 20;
    transition: all var(--transition-fast);
  }

  .modal-close-btn:hover {
    background-color: var(--color-sand);
    transform: rotate(90deg);
  }

  .modal-body-layout {
    display: grid;
    grid-template-columns: 1fr;
    overflow-y: auto;
    max-height: 90vh;
  }

  @media (min-width: 768px) {
    .modal-body-layout {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  /* Columna galería */
  .modal-gallery-col {
    background-color: var(--color-cream);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .modal-gallery-col {
      border-bottom: none;
      border-right: 1px solid var(--color-border);
    }
  }

  .modal-main-image-container {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: #FFFFFF;
    box-shadow: var(--shadow-sm);
  }

  .modal-main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform var(--transition-normal);
  }

  .modal-main-image.zoomed {
    transform: scale(1.6);
    cursor: zoom-out;
  }

  .zoom-indicator-btn {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-main);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    box-shadow: var(--shadow-xs);
  }

  .modal-thumbnails-strip {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
  }

  :global(.modal-thumb-btn) {
    width: 54px;
    height: 54px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 2px solid transparent;
    opacity: 0.7;
    transition: all var(--transition-fast);
  }

  :global(.modal-thumb-btn.is-active) {
    border-color: var(--color-sage);
    opacity: 1;
  }

  :global(.modal-thumb-btn img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Columna info */
  .modal-info-col {
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
  }

  .modal-header-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }

  .modal-cat-badge {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-sage);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .modal-stock-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #2E7D32;
    background-color: #E8F5E9;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
  }

  .badge-stock-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #2E7D32;
  }

  .modal-product-title {
    font-size: 2rem;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    padding-right: 2.5rem;
  }

  .modal-price-weight-row {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .modal-product-price {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .modal-product-weight {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .modal-promo-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-terracotta-tint);
    color: var(--color-terracotta);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
  }

  .modal-product-description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-body);
    margin-bottom: 1.5rem;
  }

  .modal-section-block {
    margin-bottom: 1.25rem;
  }

  .modal-subheading {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }

  .modal-benefits-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  :global(.modal-benefit-item) {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--color-text-body);
  }

  :global(.modal-benefit-check) {
    color: var(--color-sage);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .modal-ingredients-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  :global(.ingredient-chip) {
    background-color: var(--color-cream);
    border: 1px solid var(--color-border);
    color: var(--color-text-body);
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
  }

  .modal-skin-type-note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    background-color: var(--color-cream-subtle);
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.75rem;
  }

  /* Pie de compra */
  .modal-purchase-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .quantity-picker {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-cream);
    overflow: hidden;
  }

  .qty-btn {
    width: 38px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text-main);
    transition: background-color var(--transition-fast);
  }

  .qty-btn:hover {
    background-color: var(--color-sand);
  }

  #modal-qty-input {
    width: 36px;
    text-align: center;
    border: none;
    background: transparent;
    font-size: 1rem;
    font-weight: 700;
    font-family: inherit;
    color: var(--color-text-main);
    -moz-appearance: textfield;
  }

  #modal-qty-input::-webkit-outer-spin-button,
  #modal-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .modal-add-cart-btn {
    flex: 1;
    padding: 0.85rem 1.5rem;
    font-size: 0.95rem;
  }

  .modal-btn-subtotal {
    margin-left: 0.4rem;
    opacity: 0.85;
    font-weight: 400;
  }

  /* Selector de Variantes (Tamaño / Peso / Formato) */
  .modal-variants-block {
    margin-bottom: 1.25rem;
    padding: 0.85rem 1rem;
    background-color: var(--color-cream-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .modal-variants-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.65rem;
  }

  .modal-variants-title {
    font-size: 0.785rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-main);
  }

  .selected-variant-label {
    font-size: 0.785rem;
    font-weight: 600;
    color: var(--color-sage-hover);
    background-color: var(--color-sage-tint);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
  }

  .modal-variants-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.variant-chip-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-pill);
    background-color: #FFFFFF;
    border: 1.5px solid var(--color-border);
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--color-text-body);
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  :global(.variant-chip-btn:hover) {
    border-color: var(--color-sage-light);
    background-color: #FAF7F2;
    transform: translateY(-1px);
  }

  :global(.variant-chip-btn.is-active) {
    border-color: var(--color-sage);
    background-color: var(--color-sage-tint);
    color: var(--color-sage-hover);
    font-weight: 700;
    box-shadow: 0 2px 6px rgba(86, 110, 83, 0.2);
  }

  :global(.variant-chip-price) {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
    background-color: rgba(0, 0, 0, 0.06);
    color: var(--color-text-main);
  }

  :global(.variant-chip-btn.is-active .variant-chip-price) {
    background-color: var(--color-sage);
    color: #FFFFFF;
  }

  /* ---------------------------------------------------------------------------
     ADAPTACIÓN MÓVIL OPTIMIZADA: DETALLES DE PRODUCTO
     --------------------------------------------------------------------------- */
  @media (max-width: 767px) {
    .product-modal {
      width: 94%;
      max-width: 440px;
      max-height: 86dvh;
      height: 86dvh;
      transform: translate(-50%, -48%) scale(0.97);
    }

    .product-modal.is-active {
      transform: translate(-50%, -50%) scale(1);
    }

    .modal-dialog-inner {
      height: 100%;
      max-height: 86dvh;
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      min-height: 0;
      overflow: hidden;
    }

    .modal-close-btn {
      top: 0.65rem;
      right: 0.65rem;
      width: 32px;
      height: 32px;
      background-color: rgba(255, 255, 255, 0.95);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
      z-index: 30;
    }

    .modal-body-layout {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0;
      max-height: none;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
    }

    /* Galería en móvil: la foto ocupa el 85% del espacio */
    .modal-gallery-col {
      padding: 0.85rem 0.75rem 0.65rem;
      gap: 0.45rem;
      flex-shrink: 0;
      background-color: var(--color-cream);
      border-bottom: 1px solid var(--color-border);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .modal-main-image-container {
      width: 85%;
      max-width: 85%;
      aspect-ratio: 1 / 1;
      height: auto;
      max-height: none;
      margin: 0 auto;
      border-radius: var(--radius-md);
      box-shadow: 0 4px 14px rgba(36, 32, 28, 0.08);
    }

    .zoom-indicator-btn {
      display: none;
    }

    .modal-thumbnails-strip {
      gap: 0.35rem;
    }

    :global(.modal-thumb-btn) {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-sm);
    }

    /* Información detallada legible y compacta */
    .modal-info-col {
      padding: 0.85rem 1.15rem 0.85rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .modal-header-meta {
      gap: 0.45rem;
      margin-bottom: 0.35rem;
    }

    .modal-cat-badge {
      font-size: 0.72rem;
    }

    .modal-stock-badge {
      font-size: 0.68rem;
      padding: 0.15rem 0.45rem;
    }

    .modal-product-title {
      font-size: 1.35rem;
      line-height: 1.2;
      margin-bottom: 0.35rem;
      padding-right: 0;
    }

    .modal-price-weight-row {
      gap: 0.6rem;
      margin-bottom: 0.65rem;
    }

    .modal-product-price {
      font-size: 1.45rem;
    }

    .modal-product-weight {
      font-size: 0.82rem;
    }

    /* Selector de Variantes (Tamaño / Peso) */
    .modal-variants-block {
      padding: 0.65rem 0.85rem;
      margin-bottom: 0.75rem;
      border-radius: var(--radius-sm);
    }

    .modal-variants-header {
      margin-bottom: 0.4rem;
    }

    .modal-variants-title {
      font-size: 0.72rem;
    }

    .selected-variant-label {
      font-size: 0.72rem;
      padding: 0.1rem 0.45rem;
    }

    .modal-variants-chips {
      gap: 0.35rem;
    }

    :global(.variant-chip-btn) {
      padding: 0.35rem 0.65rem;
      font-size: 0.76rem;
      gap: 0.35rem;
    }

    :global(.variant-chip-price) {
      font-size: 0.7rem;
      padding: 0.08rem 0.32rem;
    }

    .modal-promo-box {
      padding: 0.4rem 0.65rem;
      font-size: 0.78rem;
      margin-bottom: 0.75rem;
    }

    .modal-product-description {
      font-size: 0.86rem;
      line-height: 1.5;
      margin-bottom: 0.85rem;
      color: var(--color-text-body);
    }

    .modal-section-block {
      margin-bottom: 0.75rem;
    }

    .modal-subheading {
      font-size: 0.75rem;
      margin-bottom: 0.35rem;
    }

    :global(.modal-benefit-item) {
      font-size: 0.8rem;
      gap: 0.35rem;
    }

    :global(.ingredient-chip) {
      font-size: 0.72rem;
      padding: 0.18rem 0.45rem;
    }

    .modal-skin-type-note {
      font-size: 0.78rem;
      padding: 0.45rem 0.65rem;
      margin-bottom: 0.85rem;
    }

    /* Barra de compra fija en la parte inferior para fácil acceso */
    .modal-purchase-footer {
      position: sticky;
      bottom: 0;
      left: 0;
      right: 0;
      background-color: #FFFFFF;
      padding: 0.65rem 0 0.25rem;
      margin-top: auto;
      border-top: 1px solid var(--color-border);
      box-shadow: 0 -4px 12px rgba(36, 32, 28, 0.05);
      z-index: 10;
    }

    .quantity-picker {
      height: 38px;
    }

    .qty-btn {
      width: 32px;
      height: 38px;
      font-size: 1.1rem;
    }

    #modal-qty-input {
      width: 28px;
      font-size: 0.95rem;
    }

