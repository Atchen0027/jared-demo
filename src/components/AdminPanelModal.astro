---
import { products } from '../data/products.js';
import { storeConfig } from '../data/storeConfig.js';
---

<!-- Botón flotante para acceso rápido al Panel de Control Demo -->
<div class="admin-floating-trigger-wrap">
  <button type="button" class="admin-floating-btn" id="open-admin-panel-btn" aria-label="Abrir panel de control de demostración">
    <span class="admin-btn-icon">⚙️</span>
    <span class="admin-btn-text">Panel de Control (Demo)</span>
    <span class="admin-btn-badge">Fase PHP</span>
  </button>
</div>

<!-- Backdrop y Contenedor del Panel de Control Demo -->
<div class="admin-modal-backdrop" id="admin-modal-backdrop" aria-hidden="true"></div>

<div class="admin-modal" id="admin-modal" role="dialog" aria-labelledby="admin-panel-title" aria-modal="true">
  <div class="admin-modal-inner">
    <!-- Barra superior del panel -->
    <header class="admin-topbar">
      <div class="admin-brand-info">
        <div class="admin-brand-logo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <div>
          <h2 class="admin-topbar-title" id="admin-panel-title">Panel de Control • Nubeterapia</h2>
          <span class="admin-topbar-sub">Simulación de funciones de gestión de tienda (Fase previa a backend PHP)</span>
        </div>
      </div>

      <div class="admin-topbar-actions">
        <span class="demo-pill-badge">Modo Demostración</span>
        <button type="button" class="admin-close-btn" id="admin-modal-close" aria-label="Cerrar panel de control">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- Banner informativo para el cliente -->
    <div class="admin-demo-alert">
      <span class="alert-icon">💡</span>
      <div class="alert-text">
        <div class="alert-title-row">
          <strong>Panel de Control para el Cliente (Fase PHP)</strong>
          <span class="alert-status-tag">Demo Interactiva</span>
        </div>
        <p class="alert-desc">
          Elige cualquiera de las <strong>4 opciones</strong> de abajo para explorar la gestión de inventario, modificar precios simulados, revisar pedidos de WhatsApp y configurar tarifas de envío.
        </p>
      </div>
    </div>

    <!-- Pestañas de navegación del panel (100% visibles en móvil) -->
    <nav class="admin-nav-tabs" role="tablist" aria-label="Secciones del panel de administración">
      <button type="button" role="tab" class="admin-tab is-active" data-admin-tab="dashboard" aria-selected="true">
        <span class="tab-icon">📊</span>
        <div class="admin-tab-text-wrap">
          <span class="tab-title">Resumen</span>
          <span class="tab-subtext">Métricas & Ventas</span>
        </div>
      </button>

      <button type="button" role="tab" class="admin-tab" data-admin-tab="products" aria-selected="false">
        <span class="tab-icon">🧼</span>
        <div class="admin-tab-text-wrap">
          <span class="tab-title">Catálogo</span>
          <span class="tab-subtext">Stock & Precios ({products.length})</span>
        </div>
      </button>

      <button type="button" role="tab" class="admin-tab" data-admin-tab="orders" aria-selected="false">
        <span class="tab-icon">💬</span>
        <div class="admin-tab-text-wrap">
          <span class="tab-title">Pedidos</span>
          <span class="tab-subtext">WhatsApp Recientes</span>
        </div>
      </button>

      <button type="button" role="tab" class="admin-tab" data-admin-tab="settings" aria-selected="false">
        <span class="tab-icon">⚙️</span>
        <div class="admin-tab-text-wrap">
          <span class="tab-title">Ajustes</span>
          <span class="tab-subtext">Envíos & Tienda</span>
        </div>
      </button>

      <button type="button" role="tab" class="admin-tab" data-admin-tab="promo" aria-selected="false">
        <span class="tab-icon">🎁</span>
        <div class="admin-tab-text-wrap">
          <span class="tab-title">Oferta Temporada</span>
          <span class="tab-subtext">Pop-up & Cupón</span>
        </div>
      </button>
    </nav>

    <!-- Cuerpo principal con las secciones del panel -->
    <div class="admin-body-content">
      <!-- 1. PESTAÑA DASHBOARD / MÉTRICAS -->
      <section class="admin-tab-pane is-active" id="tab-pane-dashboard">
        <div class="metrics-cards-grid">
          <div class="metric-card">
            <span class="metric-icon">💶</span>
            <div class="metric-data">
              <span class="metric-title">Ventas del Mes (Simulado)</span>
              <strong class="metric-value">1.480,00€</strong>
              <span class="metric-trend text-success">↑ +18% vs mes anterior</span>
            </div>
          </div>

          <div class="metric-card">
            <span class="metric-icon">💬</span>
            <div class="metric-data">
              <span class="metric-title">Pedidos por WhatsApp</span>
              <strong class="metric-value">48 pedidos</strong>
              <span class="metric-trend text-success">98% confirmados</span>
            </div>
          </div>

          <div class="metric-card">
            <span class="metric-icon">📦</span>
            <div class="metric-data">
              <span class="metric-title">Productos en Catálogo</span>
              <strong class="metric-value">{products.length} artículos</strong>
              <span class="metric-trend text-neutral">Todos con stock activo</span>
            </div>
          </div>

          <div class="metric-card">
            <span class="metric-icon">✨</span>
            <div class="metric-data">
              <span class="metric-title">Ticket Medio de Compra</span>
              <strong class="metric-value">30,83€</strong>
              <span class="metric-trend text-success">Cajita regalo estrella</span>
            </div>
          </div>
        </div>

        <div class="admin-chart-mock-box">
          <h4 class="chart-box-title">Actividad de Pedidos Recientes</h4>
          <div class="chart-bars-simulation">
            <div class="chart-bar-col"><span class="bar" style="height: 45%;"></span><span class="lbl">Lun</span></div>
            <div class="chart-bar-col"><span class="bar" style="height: 60%;"></span><span class="lbl">Mar</span></div>
            <div class="chart-bar-col"><span class="bar" style="height: 75%;"></span><span class="lbl">Mié</span></div>
            <div class="chart-bar-col"><span class="bar" style="height: 50%;"></span><span class="lbl">Jue</span></div>
            <div class="chart-bar-col"><span class="bar" style="height: 90%;"></span><span class="lbl">Vie</span></div>
            <div class="chart-bar-col"><span class="bar" style="height: 100%;"></span><span class="lbl">Sáb</span></div>
            <div class="chart-bar-col"><span class="bar" style="height: 65%;"></span><span class="lbl">Dom</span></div>
          </div>
        </div>
      </section>

      <!-- 2. PESTAÑA GESTIÓN DE PRODUCTOS -->
      <section class="admin-tab-pane" id="tab-pane-products" style="display: none;">
        <div class="pane-action-header">
          <div>
            <h4 class="pane-title">Gestión de Catálogo e Inventario</h4>
            <p class="pane-desc">Activa o pausa productos, actualiza precios y modifica la disponibilidad.</p>
          </div>
          <button type="button" class="btn btn-primary btn-sm admin-sim-btn" data-sim-action="crear_producto">
            <span>+ Añadir Nuevo Producto</span>
          </button>
        </div>

        <div class="table-responsive-wrapper">
          <table class="admin-data-table">
            <thead>
              <tr>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Estado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              {products.slice(0, 8).map((p) => (
                <tr>
                  <td>
                    <div class="table-product-item">
                      <img src={p.image} alt={p.name} class="table-prod-img" />
                      <div>
                        <strong>{p.name}</strong>
                        {p.promoNote && <span class="table-promo-sub">{p.promoNote}</span>}
                      </div>
                    </div>
                  </td>
                  <td><span class="table-cat-badge">{p.categoryName}</span></td>
                  <td><strong>{p.price.toFixed(2)}€</strong></td>
                  <td><span class="badge in-stock">Disponible</span></td>
                  <td>
                    <label class="switch-toggle" aria-label={`Estado activo de ${p.name}`}>
                      <input type="checkbox" checked class="admin-toggle-input" />
                      <span class="slider-round"></span>
                    </label>
                  </td>
                  <td>
                    <div class="table-actions-cell">
                      <button type="button" class="btn-action-icon admin-sim-btn" data-sim-action={`editar_${p.id}`} title="Editar producto">✏️</button>
                      <button type="button" class="btn-action-icon admin-sim-btn" data-sim-action={`precio_${p.id}`} title="Modificar precio">💶</button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="table-footer-note">Mostrando los primeros 8 productos de {products.length}. En la fase PHP se incluirá paginación y búsqueda interna.</p>
      </section>

      <!-- 3. PESTAÑA PEDIDOS DE WHATSAPP -->
      <section class="admin-tab-pane" id="tab-pane-orders" style="display: none;">
        <div class="pane-action-header">
          <div>
            <h4 class="pane-title">Registro de Pedidos Recibidos</h4>
            <p class="pane-desc">Historial de carritos enviados a través del enlace de WhatsApp.</p>
          </div>
          <button type="button" class="btn btn-secondary btn-sm admin-sim-btn" data-sim-action="exportar_pedidos">
            <span>📥 Exportar a Excel</span>
          </button>
        </div>

        <div class="table-responsive-wrapper">
          <table class="admin-data-table">
            <thead>
              <tr>
                <th>Nº Pedido</th>
                <th>Cliente</th>
                <th>Artículos</th>
                <th>Total</th>
                <th>Fecha</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>#NT-2026-089</strong></td>
                <td>Laura Gómez (Santa Cruz de Tenerife)</td>
                <td>1x Cajita de Regalo (8 jabones)</td>
                <td><strong>30,00€</strong></td>
                <td>Hoy, 14:22</td>
                <td><span class="order-status-badge status-pending">Preparando Envío</span></td>
              </tr>
              <tr>
                <td><strong>#NT-2026-088</strong></td>
                <td>Carlos Méndez (La Laguna)</td>
                <td>3x Jabones Artesanales (Lavanda, Miel, Arroz)</td>
                <td><strong>13,90€</strong></td>
                <td>Hoy, 11:05</td>
                <td><span class="order-status-badge status-delivered">Enviado (MRW)</span></td>
              </tr>
              <tr>
                <td><strong>#NT-2026-087</strong></td>
                <td>Elena R. (Las Palmas de Gran Canaria)</td>
                <td>2x Exfoliante Karité + 1x Jabón Masajeador Mango</td>
                <td><strong>22,50€</strong></td>
                <td>Ayer, 18:40</td>
                <td><span class="order-status-badge status-completed">Entregado</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 4. PESTAÑA CONFIGURACIÓN Y ENVÍOS -->
      <section class="admin-tab-pane" id="tab-pane-settings" style="display: none;">
        <div class="pane-action-header">
          <div>
            <h4 class="pane-title">Configuración General de la Tienda</h4>
            <p class="pane-desc">Parámetros globales que alimentan el frontend de Nubeterapia.</p>
          </div>
          <button type="button" class="btn btn-primary btn-sm admin-sim-btn" data-sim-action="guardar_ajustes">
            <span>💾 Guardar Cambios</span>
          </button>
        </div>

        <div class="admin-settings-form-grid">
          <div class="settings-field-group">
            <label class="settings-label">Nombre Comercial de la Marca</label>
            <input type="text" value={storeConfig.name} class="settings-input" />
          </div>

          <div class="settings-field-group">
            <label class="settings-label">Teléfono / WhatsApp de Pedidos</label>
            <input type="text" value={storeConfig.phone} class="settings-input" />
            <span class="settings-help">Número que recibe los mensajes estructurados generados en la tienda.</span>
          </div>

          <div class="settings-field-group">
            <label class="settings-label">Tarifa Estándar de Envío (€)</label>
            <input type="number" step="0.10" value={storeConfig.shipping.standardFee.toFixed(2)} class="settings-input" />
          </div>

          <div class="settings-field-group">
            <label class="settings-label">Umbral de Envío Gratuito (€)</label>
            <input type="number" step="1" value={storeConfig.shipping.freeShippingThreshold.toFixed(2)} class="settings-input" />
            <span class="settings-help">Pedidos superiores a este importe no pagarán gastos de entrega.</span>
          </div>
        </div>
      </section>

      <!-- 5. PESTAÑA OFERTA DE TEMPORADA (POP-UP CONFIGURABLE) -->
      <section class="admin-tab-pane" id="tab-pane-promo" style="display: none;">
        <div class="pane-action-header">
          <div>
            <h4 class="pane-title">Oferta Especial de la Temporada</h4>
            <p class="pane-desc">Configura el mensaje emergente promocional, el código de descuento y el beneficio de bienvenida.</p>
          </div>
          <div class="pane-action-btns-group">
            <button type="button" class="btn btn-secondary btn-sm admin-sim-btn" id="admin-promo-preview-btn">
              <span>👁️ Previsualizar Pop-up</span>
            </button>
            <button type="button" class="btn btn-primary btn-sm admin-sim-btn" id="admin-promo-save-btn">
              <span>💾 Guardar Oferta</span>
            </button>
          </div>
        </div>

        <div class="admin-settings-form-grid">
          <div class="settings-field-group field-full-width">
            <div class="promo-toggle-card">
              <div class="promo-toggle-info">
                <strong>Estado del Pop-up Promocional</strong>
                <span>Mostrar ventana emergente de bienvenida a los nuevos visitantes de la web</span>
              </div>
              <label class="switch-toggle">
                <input type="checkbox" id="admin-promo-enable" checked />
                <span class="slider-round"></span>
              </label>
            </div>
          </div>

          <div class="settings-field-group">
            <label class="settings-label" for="admin-promo-badge-input">Etiqueta de la Temporada / Badge</label>
            <input type="text" id="admin-promo-badge-input" value={storeConfig.seasonalPromo?.badge || "🌸 Oferta Especial de Temporada"} class="settings-input" />
            <span class="settings-help">Texto que aparece en la píldora superior (ej. 🌸 Oferta de Primavera).</span>
          </div>

          <div class="settings-field-group">
            <label class="settings-label" for="admin-promo-discount-badge-input">Insignia de Descuento</label>
            <input type="text" id="admin-promo-discount-badge-input" value={storeConfig.seasonalPromo?.discountBadge || "-15% DTO"} class="settings-input" />
            <span class="settings-help">Etiqueta destacada sobre la foto (ej. -15% DTO, 2x1, Regalo).</span>
          </div>

          <div class="settings-field-group field-full-width">
            <label class="settings-label" for="admin-promo-title-input">Título de la Oferta</label>
            <input type="text" id="admin-promo-title-input" value={storeConfig.seasonalPromo?.title || "15% DTO en tu Primer Pedido"} class="settings-input" />
          </div>

          <div class="settings-field-group field-full-width">
            <label class="settings-label" for="admin-promo-desc-input">Descripción / Beneficio de la Promoción</label>
            <textarea id="admin-promo-desc-input" class="settings-input settings-textarea" rows="3">{storeConfig.seasonalPromo?.description || "Descubre el descanso que tu piel merece con nuestros jabones de glicerina y cosmética botánica artesanal. Aplica el cupón al tramitar tu pedido por WhatsApp y recibe además un jaboncito de muestra de regalo."}</textarea>
          </div>

          <div class="settings-field-group">
            <label class="settings-label" for="admin-promo-code-input">Código Promocional (Cupón)</label>
            <input type="text" id="admin-promo-code-input" value={storeConfig.seasonalPromo?.code || "NUBETEMPORADA"} class="settings-input font-mono" />
            <span class="settings-help">Los clientes podrán copiarlo con un clic para enviarlo por WhatsApp.</span>
          </div>

          <div class="settings-field-group">
            <label class="settings-label" for="admin-promo-cta-input">Texto del Botón de Acción (CTA)</label>
            <input type="text" id="admin-promo-cta-input" value={storeConfig.seasonalPromo?.ctaText || "Aprovechar Oferta"} class="settings-input" />
          </div>
        </div>

        <div class="admin-promo-preview-box">
          <span class="preview-box-tag">💡 Vista previa de valores guardados:</span>
          <div class="preview-box-details">
            <p><strong>Cupón:</strong> <code id="admin-preview-code-tag">{storeConfig.seasonalPromo?.code || "NUBETEMPORADA"}</code> • <strong>Descuento:</strong> <span id="admin-preview-badge-tag">{storeConfig.seasonalPromo?.discountBadge || "-15% DTO"}</span></p>
            <p class="preview-box-hint">Pulsa en <strong>«👁️ Previsualizar Pop-up»</strong> para abrir el modal en vivo tal y como lo experimentan tus clientes.</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<style>
  /* Botón flotante */
  .admin-floating-trigger-wrap {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 90;
  }

  @media (max-width: 767px) {
    .admin-floating-trigger-wrap {
      bottom: 1rem;
      left: 1rem;
    }
  }

  .admin-floating-btn {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background-color: #24201C;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
    font-size: 0.85rem;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  @media (max-width: 767px) {
    .admin-floating-btn {
      padding: 0.45rem 0.85rem;
      font-size: 0.76rem;
      gap: 0.45rem;
      box-shadow: 0 3px 14px rgba(0, 0, 0, 0.35);
    }
  }

  .admin-floating-btn:hover {
    background-color: var(--color-sage);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(86, 110, 83, 0.35);
  }

  .admin-btn-icon {
    font-size: 1.05rem;
  }

  .admin-btn-badge {
    background-color: var(--color-gold);
    color: #1A1612;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
  }

  @media (max-width: 767px) {
    .admin-btn-badge {
      font-size: 0.62rem;
      padding: 0.1rem 0.35rem;
    }
  }

  /* Backdrop del modal */
  .admin-modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(24, 21, 18, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-normal);
    z-index: 500;
  }

  .admin-modal-backdrop.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* Modal de Administración */
  .admin-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -46%) scale(0.97);
    width: 94%;
    max-width: 1040px;
    max-height: 88vh;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    z-index: 510;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .admin-modal.is-active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .admin-modal-inner {
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 88vh;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 767px) {
    .admin-modal {
      width: 96%;
      max-height: 94vh;
    }
    .admin-modal-inner {
      max-height: 94vh;
    }
  }

  /* Topbar */
  .admin-topbar {
    background-color: #211D19;
    color: #FFFFFF;
    padding: 1.15rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #363028;
  }

  @media (max-width: 767px) {
    .admin-topbar {
      padding: 0.75rem 1rem;
    }
  }

  .admin-brand-info {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  @media (max-width: 767px) {
    .admin-brand-info {
      gap: 0.55rem;
    }
  }

  .admin-brand-logo {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background-color: rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8FA48C;
  }

  @media (max-width: 767px) {
    .admin-brand-logo {
      width: 30px;
      height: 30px;
    }
    .admin-brand-logo svg {
      width: 18px;
      height: 18px;
    }
  }

  .admin-topbar-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.2;
  }

  @media (max-width: 767px) {
    .admin-topbar-title {
      font-size: 0.95rem;
    }
  }

  .admin-topbar-sub {
    font-size: 0.785rem;
    color: #A3998E;
  }

  @media (max-width: 767px) {
    .admin-topbar-sub {
      display: none;
    }
  }

  .admin-topbar-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .demo-pill-badge {
    background-color: rgba(198, 146, 20, 0.2);
    border: 1px solid rgba(198, 146, 20, 0.4);
    color: #F1C453;
    font-size: 0.75rem;
    font-weight: 700;
