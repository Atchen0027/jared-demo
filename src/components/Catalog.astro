---
import { products } from '../data/products.js';
import { categories } from '../data/categories.js';
---

<section class="catalog-section" id="catalogo" aria-label="Catálogo de productos">
  <div class="container">
    <div class="section-header">
      <span class="section-tagline">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        Tienda Artesanal
      </span>
      <h2 class="section-title">Todos nuestros productos</h2>
      <p class="section-subtitle">
        Elaborados artesanalmente en Tenerife con aceites esenciales de grado cosmético, manteca pura y extractos botánicos.
      </p>
    </div>

    <!-- Barra de control: Filtros, Búsqueda y Ordenación -->
    <div class="catalog-controls-panel">
      <!-- Fila superior: Categorías en pestañas (pills) -->
      <div class="category-pills-bar" role="tablist" aria-label="Filtrar por categoría">
        <button 
          type="button" 
          role="tab" 
          class="pill-btn is-active" 
          data-category-filter="all" 
          aria-selected="true"
        >
          <span>Todos los productos</span>
          <span class="pill-count" id="count-all">{products.length}</span>
        </button>

        {categories.map((cat) => {
          const count = products.filter(p => p.category === cat.id).length;
          return (
            <button 
              type="button" 
              role="tab" 
              class="pill-btn" 
              data-category-filter={cat.id} 
              aria-selected="false"
            >
              <span>{cat.name}</span>
              <span class="pill-count" id={`count-${cat.id}`}>{count}</span>
            </button>
          );
        })}
      </div>

      <!-- Fila intermedia: Búsqueda, Filtro de precio, Stock y Ordenación -->
      <div class="filters-tool-row">
        <!-- Buscador de texto en tiempo real -->
        <div class="search-input-wrapper">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="search" 
            id="product-search-input" 
            placeholder="Buscar por lavanda, naranja, manteca..." 
            aria-label="Buscar producto por nombre o ingrediente"
            class="filter-search-input"
          />
          <button type="button" id="clear-search-btn" class="clear-input-btn" aria-label="Limpiar búsqueda" style="display: none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Filtro Rango de Precio -->
        <div class="price-filter-group">
          <label for="max-price-range" class="filter-label">
            <span>Precio máx:</span>
            <strong id="price-display">30,00€</strong>
          </label>
          <input 
            type="range" 
            id="max-price-range" 
            min="3" 
            max="30" 
            step="0.5" 
            value="30" 
            class="price-range-slider"
            aria-label="Filtrar por precio máximo"
          />
        </div>

        <!-- Checkbox de disponibilidad -->
        <label class="stock-checkbox-label">
          <input type="checkbox" id="stock-only-checkbox" class="custom-checkbox" />
          <span>Solo en stock</span>
        </label>

        <!-- Selector de ordenación -->
        <div class="sort-select-group">
          <label for="catalog-sort-select" class="visually-hidden">Ordenar por</label>
          <select id="catalog-sort-select" class="sort-select" aria-label="Ordenar productos">
            <option value="featured">✨ Destacados primero</option>
            <option value="price-asc">🪙 Precio: Menor a Mayor</option>
            <option value="price-desc">💎 Precio: Mayor a Menor</option>
            <option value="name-asc">🔤 Nombre: A - Z</option>
          </select>
        </div>
      </div>

      <!-- Fila de estado de filtros activos -->
      <div class="active-filters-bar" id="active-filters-bar">
        <div class="results-feedback">
          Mostrando <strong id="visible-products-count">{products.length}</strong> de {products.length} productos
          <span class="active-tag-badge" id="active-category-tag" style="display: none;">
            <span id="active-category-name"></span>
            <button type="button" class="remove-tag-btn" id="remove-cat-filter" aria-label="Quitar filtro de categoría">×</button>
          </span>
        </div>

        <button type="button" id="reset-all-filters-btn" class="reset-filters-btn" style="display: none;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
          Limpiar todos los filtros
        </button>
      </div>
    </div>

    <!-- Cuadrícula de tarjetas de productos -->
    <div class="products-grid" id="products-grid">
      {products.map((p) => (
        <article 
          class="product-card" 
          data-product-id={p.id}
          data-category={p.category}
          data-price={p.price}
          data-name={p.name.toLowerCase()}
          data-featured={p.featured ? 'true' : 'false'}
          data-stock={p.inStock ? 'true' : 'false'}
        >
          <!-- Contenedor de la foto con click para abrir modal de detalles -->
          <div 
            class="product-media" 
            data-open-detail={p.id} 
            role="button" 
            tabindex="0" 
            aria-label={`Ver detalles completos y opciones de ${p.name}`}
          >
            <img 
              src={p.image} 
              alt={p.name} 
              loading="lazy" 
              class="product-thumb"
            />
            {p.badge && (
              <span class={`product-badge ${p.badge.includes('30€') ? 'badge-gold' : 'badge-sage'}`}>
                {p.badge}
              </span>
            )}
            <button 
              type="button" 
              class="quick-view-btn" 
              data-open-detail={p.id}
              aria-label={`Ver detalles completos de ${p.name}`}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <span>Ver detalle</span>
            </button>
          </div>

          <!-- Contenido textual de la tarjeta -->
          <div class="product-info">
            <div class="product-category-meta">
              <span class="product-cat-name">{p.categoryName}</span>
              {p.weight && <span class="product-weight">{p.weight}</span>}
            </div>

            <h3 class="product-title">
              <button type="button" class="product-title-btn" data-open-detail={p.id}>
                {p.name}
              </button>
            </h3>

            <p class="product-short-desc">{p.shortDescription}</p>

            {p.promoNote && (
              <div class="promo-highlight-tag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                <span>{p.promoNote}</span>
              </div>
            )}

            <!-- Fila de precio y botón de añadir al carrito -->
            <div class="product-footer">
              <div class="product-price-block">
                <span class="price-val">{p.price.toFixed(2)}€</span>
                <span class="stock-status in-stock">En stock</span>
              </div>

              <button 
                type="button" 
                class="btn btn-primary add-cart-btn" 
                data-add-to-cart={p.id}
                aria-label={`Añadir ${p.name} al carrito`}
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-7z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span>Añadir</span>
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Estado vacío cuando ningún producto coincide -->
    <div class="empty-results-box" id="empty-catalog-state" style="display: none;">
      <div class="empty-icon-wrap">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </div>
      <h3 class="empty-title">No hemos encontrado ningún producto coincidente</h3>
      <p class="empty-desc">Prueba a ajustar o restablecer tus filtros de búsqueda o categoría.</p>
      <button type="button" class="btn btn-secondary" id="empty-reset-btn">
        Ver todo el catálogo
      </button>
    </div>
  </div>
</section>

<style>
  .catalog-section {
    padding: 3.5rem 0 5rem;
    background-color: var(--color-cream-subtle);
    border-top: 1px solid var(--color-border);
  }

  .catalog-controls-panel {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  /* Pestañas de categoría */
  .category-pills-bar {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border-light);
    scrollbar-width: thin;
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.15rem;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: var(--radius-pill);
    background-color: var(--color-cream);
    color: var(--color-text-body);
    border: 1px solid var(--color-border);
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .pill-btn:hover {
    background-color: var(--color-sand);
    color: var(--color-text-main);
  }

  .pill-btn.is-active {
    background-color: var(--color-sage);
    color: #FFFFFF;
    border-color: var(--color-sage);
    box-shadow: 0 2px 8px rgba(86, 110, 83, 0.25);
  }

  .pill-count {
    background-color: rgba(0, 0, 0, 0.08);
    font-size: 0.75rem;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-pill);
  }

  .pill-btn.is-active .pill-count {
    background-color: rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
  }

  /* Fila de herramientas: búsqueda, slider, sort */
  .filters-tool-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: center;
  }

  @media (min-width: 640px) {
    .filters-tool-row {
      grid-template-columns: 1.8fr 1.2fr auto 1.4fr;
    }
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.85rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .filter-search-input {
    width: 100%;
    padding: 0.65rem 2.2rem 0.65rem 2.4rem;
    font-size: 0.9rem;
    font-family: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-cream);
    color: var(--color-text-main);
    transition: all var(--transition-fast);
  }

  .filter-search-input:focus {
    background-color: #FFFFFF;
    border-color: var(--color-sage);
    box-shadow: 0 0 0 3px var(--color-sage-tint);
  }

  .clear-input-btn {
    position: absolute;
    right: 0.75rem;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background-color: var(--color-sand);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-main);
  }

  .price-filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .filter-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .filter-label strong {
    color: var(--color-text-main);
  }

  .price-range-slider {
    width: 100%;
    accent-color: var(--color-sage);
    cursor: pointer;
  }

  .stock-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-body);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }

  .custom-checkbox {
    width: 17px;
    height: 17px;
    accent-color: var(--color-sage);
    cursor: pointer;
  }

  .sort-select {
    width: 100%;
    padding: 0.65rem 1rem;
    font-size: 0.88rem;
    font-family: inherit;
    font-weight: 500;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background-color: var(--color-cream);
    color: var(--color-text-main);
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }

  .sort-select:focus {
    border-color: var(--color-sage);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* Barra de filtros activos */
  .active-filters-bar {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .results-feedback {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-text-muted);
  }

  .active-tag-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--color-sage-tint);
    color: var(--color-sage);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    font-weight: 600;
  }

  .remove-tag-btn {
    font-size: 1rem;
    line-height: 1;
    color: var(--color-sage);
    cursor: pointer;
  }

  .reset-filters-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-terracotta);
    font-size: 0.825rem;
    font-weight: 600;
    cursor: pointer;
  }

  .reset-filters-btn:hover {
    text-decoration: underline;
  }

  /* Grid de productos: 3 de ancho en móvil (vista compacta de 3 en 3 y 9 en pantalla) */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.55rem;
  }

  @media (min-width: 768px) {
    .products-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 1100px) {
    .products-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.75rem;
    }
  }

  /* Tarjeta de producto */
  .product-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-xs);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-sand-dark);
  }

  .product-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: var(--color-cream);
    overflow: hidden;
    cursor: pointer;
  }

  .product-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-card:hover .product-thumb {
    transform: scale(1.08);
  }

  .product-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-xs);
  }

  .quick-view-btn {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translate(-50%, 15px);
    opacity: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-main);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
    white-space: nowrap;
  }

  .product-card:hover .quick-view-btn {
    transform: translate(-50%, 0);
    opacity: 1;
  }

  .product-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-category-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0.35rem;
  }

  .product-cat-name {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--color-sage);
  }

  .product-title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.45rem;
  }

  .product-title-btn {
    text-align: left;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    color: var(--color-text-main);
    transition: color var(--transition-fast);
  }

  .product-title-btn:hover {
    color: var(--color-sage);
  }

  .product-short-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin-bottom: 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .promo-highlight-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-terracotta);
    background-color: var(--color-terracotta-tint);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    align-self: flex-start;
  }

  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border-light);
    margin-top: auto;
  }

  .product-price-block {
    display: flex;
    flex-direction: column;
  }

  .price-val {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1;
  }

  .stock-status {
    font-size: 0.7rem;
    font-weight: 600;
    color: #388E3C;
    margin-top: 0.2rem;
  }

  .add-cart-btn {
    padding: 0.55rem 1rem;
    font-size: 0.85rem;
  }

  /* Adaptaciones específicas para vista móvil en 3 columnas (3 en ancho y 9 en pantalla) */
  @media (max-width: 767px) {
    .catalog-section {
      padding: 2.5rem 0 3.5rem;
    }

    .catalog-section .container {
      padding-left: 0.65rem;
      padding-right: 0.65rem;
    }

    .catalog-controls-panel {
      padding: 1rem 0.85rem;
      margin-bottom: 1.5rem;
    }

    .product-card {
      border-radius: var(--radius-sm);
    }

    .product-badge {
      top: 0.35rem;
      left: 0.35rem;
      font-size: 0.55rem;
      padding: 0.12rem 0.35rem;
    }

    .quick-view-btn {
      display: none !important;
    }

    .product-info {
      padding: 0.45rem 0.35rem 0.55rem;
    }

    .product-category-meta {
      display: none;
    }

    .product-title {
      font-size: 0.78rem;
      line-height: 1.25;
      margin-bottom: 0.25rem;
      min-height: 2.5em;
    }

    .product-title-btn {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-short-desc {
      display: none !important;
    }

    .promo-highlight-tag {
      display: none !important;
    }

    .product-footer {
      flex-direction: column;
      align-items: stretch;
      gap: 0.35rem;
      padding-top: 0.35rem;
      margin-top: auto;
    }

    .product-price-block {
      text-align: center;
    }

    .price-val {
      font-size: 0.95rem;
    }

    .stock-status {
      display: none;
    }

    .add-cart-btn {
      width: 100%;
      padding: 0.35rem 0.2rem;
      font-size: 0.72rem;
      gap: 0.25rem;
      border-radius: var(--radius-pill);
    }

    .add-cart-btn svg {
      width: 13px;
      height: 13px;
    }
  }

  /* Estado vacío */
